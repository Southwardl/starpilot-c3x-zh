+  try:
+    chronological = sorted(routes, key=lambda r: r.date)   # 旧 -> 新
+  except Exception:
+    chronological = []
+  total_routes = len(chronological)
+  for offset, route in enumerate(reversed(chronological[-5:])):   # 新 -> 旧
+    number = total_routes - 1 - offset                            # 最新一次 = 总数-1
+    stamp = route.date.strftime("%m-%d %H:%M")
+    left = tr("第{}次 · {}").format(number, stamp)
+    dist = route.distance_meters / 1000.0 if is_metric else route.distance_meters / METER_TO_MILE
+    minutes = max(0, int(round(route.duration / 60.0)))
+    right = tr("{} {} · {} 分钟").format(f"{dist:.1f}", unit_short, minutes)
+    recent.append((left, right))
+
