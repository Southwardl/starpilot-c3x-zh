msgstr "盲区检测警报加响"

msgid "\"Taco Bell Run\" Turn Speed Hack"
msgstr "\"Taco Bell Run\" 转向速度补丁"

msgid "\"Detected\" Stop Lights/Signs"
msgstr "\"检测到的\"停车灯/标志"

msgid "Force Stop at \"Detected\" Stop Lights/Signs"
msgstr "在\"检测到的\"停车灯/标志处强制停车"

